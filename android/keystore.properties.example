# ==============================================================================
# Sahm Download Manager (سهم) — Release Signing Configuration Template
# Developer: Elmahdi Dev
# ==============================================================================
#
# INSTRUCTIONS:
# 1. Copy this template to 'keystore.properties' (in the android/ root directory):
#    cp keystore.properties.example keystore.properties
#
# 2. Generate a secure release keystore if you don't already have one:
#    keytool -genkey -v -keystore sahm-release.keystore -alias sahm_release_key \
#      -keyalg RSA -keysize 2048 -validity 10000
#
# 3. Fill in your actual keystore credentials below.
#
# 4. CRITICAL SECURITY NOTICE:
#    - NEVER commit 'keystore.properties' or your '.keystore' / '.jks' file to Git!
#    - Both are explicitly ignored by .gitignore.
#    - In CI (e.g. GitHub Actions), supply these as repository secrets instead.
# ==============================================================================

# Relative path from android/ directory or absolute path to the keystore file
SAHM_KEYSTORE_PATH=sahm-release.keystore

# Keystore protection password
SAHM_KEYSTORE_PASSWORD=YOUR_SECURE_KEYSTORE_PASSWORD

# Key alias inside the keystore
SAHM_KEY_ALIAS=sahm_release_key

# Key private password
SAHM_KEY_PASSWORD=YOUR_SECURE_KEY_PASSWORD
